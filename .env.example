# Copy to .env and replace placeholders locally. Never commit .env.
POSTGRES_ADMIN_PASSWORD=replace-with-local-postgres-admin-password
BEREV_APP_PASSWORD=generate-and-store-during-local-role-setup
DATABASE_URL=postgresql+psycopg://berev_app:replace-me@127.0.0.1:5432/berev_dev
TEST_DATABASE_URL=postgresql+psycopg://berev_app:replace-me@127.0.0.1:5432/berev_test
JWT_SECRET_KEY=replace-with-at-least-32-random-secret-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOG_LEVEL=INFO
